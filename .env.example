# Database (PostgreSQL - Supabase / Neon)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-ID]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Supabase Storage & SDK (Opsional untuk Media/Gambar Soal)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-ID].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[YOUR-ANON-KEY]"

# Session Secret (Minimal 32 karakter acak)
SESSION_SECRET="cerdasify_super_secret_session_key_min_32_chars"

# Default Super Admin (untuk initial seeding)
DEFAULT_ADMIN_USERNAME="superadmin"
DEFAULT_ADMIN_PASSWORD="SuperPassword123!"

# App Config
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Cerdasify"
NEXT_PUBLIC_APP_URL="http://localhost:3000"