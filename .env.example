# Database (SQLite with WAL mode)
DATABASE_PATH="./data/cerdasify.db"

# Session Secret (Minimal 32 karakter acak)
SESSION_SECRET="cerdasify_super_secret_session_key_min_32_chars"

# Default Super Admin (untuk initial seeding)
DEFAULT_ADMIN_USERNAME="superadmin"
DEFAULT_ADMIN_PASSWORD="SuperPassword123!"

# App Config
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Cerdasify"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
